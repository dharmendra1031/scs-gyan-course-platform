DEBUG=False
SECRET_KEY=replace-with-a-unique-long-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DB_ENGINE=mssql
DB_NAME=scs_gyan
DB_HOST=localhost
DB_PORT=1433
DB_USER=scs_gyan_app
DB_PASSWORD=replace-with-database-password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no

# Optional Razorpay Test Mode credentials; never commit actual keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production only, after HTTPS and subdomain rollout are verified
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_REVERSE_PROXY_HTTPS=False

# Password recovery is disabled until working SMTP credentials are configured.
PASSWORD_RESET_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
