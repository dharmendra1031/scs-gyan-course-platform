# Copy to .env on the STAGING SERVER ONLY (never commit .env).
DEBUG=False
SECRET_KEY=replace-with-a-random-unique-secret-at-least-40-characters
ALLOWED_HOSTS=staging.example.org
CSRF_TRUSTED_ORIGINS=https://staging.example.org

DB_ENGINE=mssql
DB_NAME=scs_gyan_staging
DB_HOST=sql-server-hostname
DB_PORT=1433
DB_USER=scs_staging_app
DB_PASSWORD=replace-with-a-strong-db-password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=no

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_REVERSE_PROXY_HTTPS=True

# Disable all payment transactions on the UI demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
